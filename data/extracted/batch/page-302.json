      "nodes": [
        {
          "id": 1,
          "parent": 0,
          "lang": "Persian",
          "refs": "BQT:1879; MON:3536",
          "words": [
            {"translit": "lâleh", "gloss": "a red flower (tulip)", "script": "لاله"},
            {"translit": "âlâleh", "gloss": "a red flower", "script": "آلاله"}
          ],
          "script_extra": null,
          "note": null,
          "quote": {
            "text": "دو لب چو نار کفیده، دو رخ چو سوسن سرخ - دو رخ چو نار شکفته، دو لب چو لالهٔ لال",
            "poet": "Onsorî"
          }
        },
        {
          "id": 2,
          "parent": 0,
          "lang": "Persian",
          "refs": "BQT:1880; MON:3536",
          "words": [
            {"translit": "lâlak", "gloss": "red leather and shoes made from it", "script": "لالک ( لالکا )"}
          ],
          "script_extra": null,
          "note": null,
          "quote": {
            "text": "دریغ از ان شرف و خوبی و فضایل او - که عاشق است بر ان لاله روی لالک دوز",
            "poet": "Sŭzanî"
          }
        },
        {
          "id": 3,
          "parent": 0,
          "lang": "Persian",
          "refs": "BQT:1880",
          "words": [
            {"translit": "lâleh-sâr", "gloss": "a red-headed bird", "script": "لاله سار", "see": ["Ker 1"]},
            {"translit": "lâlas", "gloss": "a red silk fabric", "script": "لالس"}
          ],
          "script_extra": null,
          "note": null,
          "quote": {
            "text": "گه در قدم باغ کشد فضل تو دیبا - گه بر سر کهسار نهد حکم تو لالس",
            "poet": "Badr Jâjermî"
          }
        },
        {
          "id": 4,
          "parent": 0,
          "lang": "Arabic",
          "refs": "AFM:142; PLA:241; TAD:66",
